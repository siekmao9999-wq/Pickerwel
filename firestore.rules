rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isPrimaryAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'siekmao9999@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isApprovedUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved';
    }

    function isActivePasscodeMember(memberId) {
      return isValidMemberId(memberId) &&
        exists(/databases/$(database)/documents/passcodeMembers/$(memberId)) &&
        get(/databases/$(database)/documents/passcodeMembers/$(memberId)).data.status == 'approved' &&
        (
          !exists(/databases/$(database)/documents/passcodes/$(get(/databases/$(database)/documents/passcodeMembers/$(memberId)).data.passcode)) ||
          get(/databases/$(database)/documents/passcodes/$(get(/databases/$(database)/documents/passcodeMembers/$(memberId)).data.passcode)).data.active == true
        );
    }

    // Entity Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'status',
          'theme', 'language', 'soundEnabled', 'confettiEnabled',
          'hapticsEnabled', 'spinDuration',
          'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'status',
          'theme', 'language', 'soundEnabled', 'confettiEnabled',
          'hapticsEnabled', 'spinDuration',
          'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy',
          'assignedCode'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() <= 120 &&
        data.role in ['user', 'admin'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.theme in ['light', 'dark'] &&
        data.language in ['km', 'en'] &&
        data.soundEnabled is bool &&
        data.confettiEnabled is bool &&
        data.hapticsEnabled is bool &&
        (data.spinDuration is int || data.spinDuration is float) &&
        data.spinDuration >= 3 && data.spinDuration <= 10 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.reviewedAt is timestamp &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128 &&
        (!('assignedCode' in data) || (data.assignedCode is string && (data.assignedCode == '' || isValidPasscodeId(data.assignedCode))));
    }

    function isValidAdminMember(data, adminUid) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == adminUid &&
        data.createdAt is timestamp;
    }

    function isValidWheel(data, userId, wheelId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'entries', 'paletteId',
          'spinCount', 'lastWinner', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'title', 'entries', 'paletteId',
          'spinCount', 'lastWinner', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == wheelId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.entries is list &&
        data.entries.size() <= 200 &&
        (data.entries.size() == 0 || (data.entries[0] is string && data.entries[0].size() <= 120)) &&
        data.paletteId in ['vibrant', 'classroom', 'sunset', 'ocean'] &&
        (data.spinCount is int || data.spinCount is float) &&
        data.spinCount >= 0 && data.spinCount <= 1000000 &&
        data.lastWinner is string && data.lastWinner.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSpinResult(data, userId, resultId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'wheelId', 'wheelTitle',
          'winner', 'winnerColor', 'removedAfterSpin', 'spunAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'wheelId', 'wheelTitle',
          'winner', 'winnerColor', 'removedAfterSpin', 'spunAt'
        ]) &&
        isValidId(data.id) &&
        data.id == resultId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.wheelId) &&
        data.wheelTitle is string && data.wheelTitle.size() >= 1 && data.wheelTitle.size() <= 120 &&
        data.winner is string && data.winner.size() >= 1 && data.winner.size() <= 120 &&
        data.winnerColor is string && data.winnerColor.size() == 7 &&
        data.winnerColor.matches('^#[0-9a-fA-F]{6}$') &&
        data.removedAfterSpin is bool &&
        data.spunAt is timestamp;
    }

    function isValidPasscodeId(codeId) {
      return codeId is string &&
        codeId.size() >= 4 &&
        codeId.size() <= 32 &&
        codeId.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidMemberId(memberId) {
      return memberId is string &&
        memberId.size() >= 16 &&
        memberId.size() <= 128 &&
        memberId.matches('^pm_[a-zA-Z0-9_\\-]+$');
    }

    function isValidAssignmentId(assignmentId) {
      return assignmentId is string &&
        assignmentId.size() >= 16 &&
        assignmentId.size() <= 128 &&
        assignmentId.matches('^asgn_[a-zA-Z0-9_\\-]+$');
    }

    function isValidPasscode(data, codeId) {
      return data.keys().hasAll(['code', 'label', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['code', 'label', 'active', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidPasscodeId(data.code) &&
        data.code == codeId &&
        data.label is string && data.label.size() <= 80 &&
        data.active is bool &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRequestId(requestId) {
      return requestId is string &&
        requestId.size() >= 16 &&
        requestId.size() <= 128 &&
        requestId.matches('^req_[a-zA-Z0-9_\\-]+$');
    }

    function isValidPasscodeMember(data, memberId) {
      return data.keys().hasAll(['id', 'displayName', 'passcode', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'passcode', 'status', 'adminNote', 'createdAt', 'updatedAt']) &&
        isValidMemberId(data.id) &&
        data.id == memberId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidPasscodeId(data.passcode) &&
        data.status in ['approved', 'rejected'] &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 160)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRegistrationRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'displayName', 'note', 'status', 'assignedCode',
          'memberId', 'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
        ]) &&
        data.keys().hasOnly([
          'id', 'displayName', 'note', 'status', 'assignedCode',
          'memberId', 'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
        ]) &&
        isValidRequestId(data.id) &&
        data.id == requestId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.note is string && data.note.size() <= 120 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.assignedCode is string && (data.assignedCode == '' || isValidPasscodeId(data.assignedCode)) &&
        data.memberId is string && (data.memberId == '' || isValidMemberId(data.memberId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.reviewedAt is timestamp &&
        data.reviewedBy is string && data.reviewedBy.size() <= 128;
    }

    function isValidPublicConfig(data) {
      return data.keys().hasAll(['adminName', 'updatedAt']) &&
        data.keys().hasOnly(['adminName', 'autoDropEnabled', 'defaultPasscode', 'updatedAt']) &&
        data.adminName is string && data.adminName.size() >= 1 && data.adminName.size() <= 80 &&
        (!('autoDropEnabled' in data) || data.autoDropEnabled is bool) &&
        (!('defaultPasscode' in data) || (data.defaultPasscode is string && (data.defaultPasscode == '' || isValidPasscodeId(data.defaultPasscode)))) &&
        data.updatedAt is timestamp;
    }

    function isValidStudentAssignment(data, assignmentId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ownerType', 'ownerDisplayName',
          'title', 'instructions', 'entries', 'paletteId',
          'allowWheelSpin', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'ownerType', 'ownerDisplayName',
          'title', 'instructions', 'entries', 'paletteId',
          'allowWheelSpin', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidAssignmentId(data.id) &&
        data.id == assignmentId &&
        data.ownerType in ['google', 'passcode'] &&
        (
          (data.ownerType == 'google' && isValidId(data.ownerId)) ||
          (data.ownerType == 'passcode' && isValidMemberId(data.ownerId))
        ) &&
        data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.instructions is string && data.instructions.size() <= 2000 &&
        data.entries is list &&
        data.entries.size() <= 200 &&
        (data.entries.size() == 0 || (data.entries[0] is string && data.entries[0].size() <= 120)) &&
        data.paletteId in ['vibrant', 'classroom', 'sunset', 'ocean'] &&
        data.allowWheelSpin is bool &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentSubmission(data, assignmentId, submissionId) {
      return data.keys().hasAll([
          'id', 'assignmentId', 'ownerId', 'studentName',
          'groupLabel', 'drawnItem', 'answerText', 'status', 'submittedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'assignmentId', 'ownerId', 'studentName',
          'groupLabel', 'drawnItem', 'answerText', 'status', 'submittedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == submissionId &&
        isValidAssignmentId(data.assignmentId) &&
        data.assignmentId == assignmentId &&
        isValidId(data.ownerId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 80 &&
        data.groupLabel is string && data.groupLabel.size() <= 60 &&
        data.drawnItem is string && data.drawnItem.size() <= 120 &&
        data.answerText is string && data.answerText.size() >= 1 && data.answerText.size() <= 2000 &&
        data.status in ['submitted', 'reviewed'] &&
        data.submittedAt is timestamp;
    }

    function isValidFormId(formId) {
      return formId is string &&
        formId.size() >= 16 &&
        formId.size() <= 128 &&
        formId.matches('^frm_[a-zA-Z0-9_\\-]+$');
    }

    function isValidCustomForm(data, formId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ownerType', 'ownerDisplayName',
          'title', 'description', 'themeId', 'questions',
          'acceptingResponses', 'isQuiz', 'collectRespondentName',
          'emailMode', 'allowMultipleResponses', 'shuffleQuestions',
          'confirmationMessage', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'ownerType', 'ownerDisplayName',
          'title', 'description', 'themeId', 'questions',
          'acceptingResponses', 'isQuiz', 'collectRespondentName',
          'emailMode', 'allowMultipleResponses', 'shuffleQuestions',
          'confirmationMessage', 'published', 'createdAt', 'updatedAt'
        ]) &&
        isValidFormId(data.id) &&
        data.id == formId &&
        data.ownerType in ['google', 'passcode'] &&
        (
          (data.ownerType == 'google' && isValidId(data.ownerId)) ||
          (data.ownerType == 'passcode' && isValidMemberId(data.ownerId))
        ) &&
        data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.description is string && data.description.size() <= 2000 &&
        data.themeId in ['purple', 'indigo', 'blue', 'teal', 'emerald', 'rose', 'amber'] &&
        data.questions is list &&
        data.questions.size() <= 50 &&
        (data.questions.size() == 0 || data.questions[0] is map) &&
        data.acceptingResponses is bool &&
        data.isQuiz is bool &&
        data.collectRespondentName is bool &&
        data.emailMode in ['none', 'optional', 'required'] &&
        data.allowMultipleResponses is bool &&
        data.shuffleQuestions is bool &&
        data.confirmationMessage is string && data.confirmationMessage.size() <= 400 &&
        data.published is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFormResponse(data, formId, responseId) {
      return data.keys().hasAll([
          'id', 'formId', 'ownerId', 'respondentName', 'respondentEmail',
          'answers', 'score', 'maxScore', 'submittedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'formId', 'ownerId', 'respondentName', 'respondentEmail',
          'answers', 'score', 'maxScore', 'submittedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == responseId &&
        isValidFormId(data.formId) &&
        data.formId == formId &&
        isValidId(data.ownerId) &&
        data.respondentName is string && data.respondentName.size() <= 80 &&
        data.respondentEmail is string && data.respondentEmail.size() <= 120 &&
        data.answers is list &&
        data.answers.size() <= 50 &&
        (data.answers.size() == 0 || data.answers[0] is map) &&
        (data.score is int || data.score is float) &&
        data.score >= 0 && data.score <= 10000 &&
        (data.maxScore is int || data.maxScore is float) &&
        data.maxScore >= 0 && data.maxScore <= 10000 &&
        data.submittedAt is timestamp;
    }

    // Admin Registry Collection (Primary Admin Only)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(adminUid) &&
        isPrimaryAdmin() &&
        isValidAdminMember(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isPrimaryAdmin() && adminUid != request.auth.uid;
    }

    // User Profile Collection (Owner + Admin Approval Gate)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().reviewedAt == request.time &&
        (
          (isAdmin() && incoming().role == 'admin' && incoming().status == 'approved') ||
          (!isAdmin() && incoming().role == 'user' && incoming().status == 'pending' && incoming().reviewedBy == '')
        );
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isPrimaryAdmin() &&
            incoming().role == 'user' &&
            incoming().reviewedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'role', 'reviewedAt', 'reviewedBy', 'updatedAt', 'assignedCode'
            ])
          ) ||
          (
            isOwner(userId) &&
            existing().status == 'approved' &&
            incoming().status == existing().status &&
            incoming().role == existing().role &&
            incoming().reviewedAt == existing().reviewedAt &&
            incoming().reviewedBy == existing().reviewedBy &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'theme', 'language',
              'soundEnabled', 'confettiEnabled', 'hapticsEnabled',
              'spinDuration', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;

      // Saved Wheels Subcollection (Approved Users Only)
      match /wheels/{wheelId} {
        allow get: if isValidId(userId) && isValidId(wheelId) && isOwner(userId) && isApprovedUser(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(wheelId) &&
          isOwner(userId) &&
          isValidWheel(incoming(), userId, wheelId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isApprovedUser(userId);
        allow update: if isValidId(userId) &&
          isValidId(wheelId) &&
          isOwner(userId) &&
          isValidWheel(incoming(), userId, wheelId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isApprovedUser(userId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'entries', 'paletteId', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'spinCount', 'lastWinner', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['spinCount', 'lastWinner', 'updatedAt'])
          );
        allow delete: if isValidId(userId) &&
          isValidId(wheelId) &&
          isOwner(userId) &&
          isApprovedUser(userId);
      }

      // Spin Results History Subcollection (Approved Users Only)
      match /spinResults/{resultId} {
        allow get: if isValidId(userId) && isValidId(resultId) && isOwner(userId) && isApprovedUser(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(resultId) &&
          isOwner(userId) &&
          isValidSpinResult(incoming(), userId, resultId) &&
          incoming().spunAt == request.time &&
          isApprovedUser(userId);
        allow update: if false;
        allow delete: if isValidId(userId) &&
          isValidId(resultId) &&
          isOwner(userId) &&
          isApprovedUser(userId);
      }
    }

    // Admin-Issued Registration Passcodes (Created & Managed Strictly by Primary Admin)
    match /passcodes/{codeId} {
      allow get: if isValidPasscodeId(codeId);
      allow list: if isPrimaryAdmin();
      allow create: if isValidPasscodeId(codeId) &&
        isPrimaryAdmin() &&
        isValidPasscode(incoming(), codeId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidPasscodeId(codeId) &&
        isPrimaryAdmin() &&
        isValidPasscode(incoming(), codeId) &&
        incoming().code == existing().code &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'updatedAt']);
      allow delete: if isValidPasscodeId(codeId) && isPrimaryAdmin();
    }

    // Email-less Passcode Member Registrations
    match /passcodeMembers/{memberId} {
      allow get: if isValidMemberId(memberId);
      allow list: if isAdmin();
      allow create: if isValidMemberId(memberId) &&
        isValidPasscodeMember(incoming(), memberId) &&
        !('adminNote' in incoming()) &&
        incoming().status == 'approved' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            exists(/databases/$(database)/documents/passcodes/$(incoming().passcode)) &&
            get(/databases/$(database)/documents/passcodes/$(incoming().passcode)).data.active == true
          ) ||
          (
            (
              !exists(/databases/$(database)/documents/appConfig/public) ||
              !('autoDropEnabled' in get(/databases/$(database)/documents/appConfig/public).data) ||
              get(/databases/$(database)/documents/appConfig/public).data.autoDropEnabled == true
            ) &&
            (
              !exists(/databases/$(database)/documents/passcodes/$(incoming().passcode)) ||
              get(/databases/$(database)/documents/passcodes/$(incoming().passcode)).data.active == true
            )
          )
        );
      allow update: if isValidMemberId(memberId) &&
        isAdmin() &&
        isValidPasscodeMember(incoming(), memberId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'passcode', 'status', 'adminNote', 'updatedAt'
        ]);
      allow delete: if isValidMemberId(memberId) && isAdmin();
    }

    // User Registration Requests Waiting for Admin to Assign a Code
    match /registrationRequests/{requestId} {
      allow get: if isValidRequestId(requestId);
      allow list: if isAdmin();
      allow create: if isValidRequestId(requestId) &&
        isValidRegistrationRequest(incoming(), requestId) &&
        incoming().status == 'pending' &&
        incoming().assignedCode == '' &&
        incoming().memberId == '' &&
        incoming().reviewedBy == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().reviewedAt == request.time;
      allow update: if isValidRequestId(requestId) &&
        isPrimaryAdmin() &&
        isValidRegistrationRequest(incoming(), requestId) &&
        incoming().id == existing().id &&
        incoming().displayName == existing().displayName &&
        incoming().note == existing().note &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().reviewedAt == request.time &&
        incoming().reviewedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'assignedCode', 'memberId', 'reviewedAt', 'reviewedBy', 'updatedAt'
        ]) &&
        (
          incoming().status != 'approved' ||
          (isValidPasscodeId(incoming().assignedCode) && isValidMemberId(incoming().memberId))
        );
      allow delete: if isValidRequestId(requestId) && isPrimaryAdmin();
    }

    // Public Non-PII App Config (Admin Display Name)
    match /appConfig/{docId} {
      allow get: if isValidId(docId) && docId == 'public';
      allow list: if false;
      allow create, update: if isValidId(docId) &&
        docId == 'public' &&
        isAdmin() &&
        isValidPublicConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Per-User Student Practice Assignments (Unique Link & QR-Code, Owner-Isolated, Admin Full View)
    match /assignments/{assignmentId} {
      allow get: if isValidAssignmentId(assignmentId);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidAssignmentId(assignmentId) &&
        isValidStudentAssignment(incoming(), assignmentId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().ownerType == 'google' &&
            incoming().ownerId == request.auth.uid &&
            (isAdmin() || isApprovedUser(request.auth.uid))
          ) ||
          (
            incoming().ownerType == 'passcode' &&
            isActivePasscodeMember(incoming().ownerId)
          )
        );
      allow update: if isValidAssignmentId(assignmentId) &&
        isValidStudentAssignment(incoming(), assignmentId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().ownerType == existing().ownerType &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'instructions', 'entries', 'paletteId', 'allowWheelSpin', 'active', 'updatedAt'
        ]) &&
        (
          isAdmin() ||
          (
            existing().ownerType == 'google' &&
            isOwner(existing().ownerId) &&
            isApprovedUser(existing().ownerId)
          )
        );
      allow delete: if isValidAssignmentId(assignmentId) &&
        (
          isAdmin() ||
          (
            existing().ownerType == 'google' &&
            isOwner(existing().ownerId) &&
            isApprovedUser(existing().ownerId)
          )
        );

      // Student Work Submissions (Owner + Admin Only Read; Active Assignment Student Create)
      match /submissions/{submissionId} {
        allow get: if isValidAssignmentId(assignmentId) &&
          isValidId(submissionId) &&
          (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
        allow list: if isValidAssignmentId(assignmentId) &&
          (isAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid));
        allow create: if isValidAssignmentId(assignmentId) &&
          isValidId(submissionId) &&
          isValidStudentSubmission(incoming(), assignmentId, submissionId) &&
          incoming().status == 'submitted' &&
          incoming().submittedAt == request.time &&
          exists(/databases/$(database)/documents/assignments/$(assignmentId)) &&
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.active == true &&
          incoming().ownerId == get(/databases/$(database)/documents/assignments/$(assignmentId)).data.ownerId;
        allow update: if isValidAssignmentId(assignmentId) &&
          isValidId(submissionId) &&
          isValidStudentSubmission(incoming(), assignmentId, submissionId) &&
          incoming().id == existing().id &&
          incoming().assignmentId == existing().assignmentId &&
          incoming().ownerId == existing().ownerId &&
          incoming().submittedAt == existing().submittedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
          (
            isAdmin() ||
            (isVerifiedUser() && existing().ownerId == request.auth.uid && isApprovedUser(request.auth.uid))
          );
        allow delete: if isValidAssignmentId(assignmentId) &&
          isValidId(submissionId) &&
          (
            isAdmin() ||
            (isVerifiedUser() && existing().ownerId == request.auth.uid && isApprovedUser(request.auth.uid))
          );
      }
    }

    // Google Forms-Style Custom Forms (Unique Share Link & QR-Code, Owner-Isolated Responses, Admin Full View)
    match /forms/{formId} {
      allow get: if isValidFormId(formId);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidFormId(formId) &&
        isValidCustomForm(incoming(), formId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isVerifiedUser() &&
            incoming().ownerType == 'google' &&
            incoming().ownerId == request.auth.uid &&
            (isAdmin() || isApprovedUser(request.auth.uid))
          ) ||
          (
            incoming().ownerType == 'passcode' &&
            isActivePasscodeMember(incoming().ownerId)
          )
        );
      allow update: if isValidFormId(formId) &&
        isValidCustomForm(incoming(), formId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().ownerType == existing().ownerType &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'themeId', 'questions',
          'acceptingResponses', 'isQuiz', 'collectRespondentName',
          'emailMode', 'allowMultipleResponses', 'shuffleQuestions',
          'confirmationMessage', 'published', 'updatedAt'
        ]) &&
        (
          isAdmin() ||
          (
            existing().ownerType == 'google' &&
            isOwner(existing().ownerId) &&
            isApprovedUser(existing().ownerId)
          )
        );
      allow delete: if isValidFormId(formId) &&
        (
          isAdmin() ||
          (
            existing().ownerType == 'google' &&
            isOwner(existing().ownerId) &&
            isApprovedUser(existing().ownerId)
          )
        );

      // Form Responses Subcollection (Owner + Admin Only Read; Public Submit While Published & Accepting)
      match /responses/{responseId} {
        allow get: if isValidFormId(formId) &&
          isValidId(responseId) &&
          (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
        allow list: if isValidFormId(formId) &&
          (isAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid));
        allow create: if isValidFormId(formId) &&
          isValidId(responseId) &&
          isValidFormResponse(incoming(), formId, responseId) &&
          incoming().submittedAt == request.time &&
          exists(/databases/$(database)/documents/forms/$(formId)) &&
          get(/databases/$(database)/documents/forms/$(formId)).data.published == true &&
          get(/databases/$(database)/documents/forms/$(formId)).data.acceptingResponses == true &&
          incoming().ownerId == get(/databases/$(database)/documents/forms/$(formId)).data.ownerId;
        allow update: if false;
        allow delete: if isValidFormId(formId) &&
          isValidId(responseId) &&
          (
            isAdmin() ||
            (isVerifiedUser() && existing().ownerId == request.auth.uid && isApprovedUser(request.auth.uid))
          );
      }
    }
  }
}
